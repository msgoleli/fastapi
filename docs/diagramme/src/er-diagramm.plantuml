@startuml ER Diagramm
hide circle
skinparam linetype ortho

entity "Buch" {
  * id : integer <<PK>>
  --
  * titel : text
  * isbn : text <<unique>>
  * erscheinungsdatum : date
  * genre : text
  * verlag_id : integer <<FK>>
}

entity "Autor" {
  * id : integer <<PK>>
  --
  * vorname : text
  * nachname : text
  * email : text <<unique>>
}

entity "Verlag" {
  * id : integer <<PK>>
  --
  * name : text <<unique>>
  * sitz : text
    website : text
}

entity "BuchAutor" {
  * buch_id : integer <<PK, FK>>
  * autor_id : integer <<PK, FK>>
}

Buch }o..|| Verlag
Buch ||..o{ BuchAutor
Autor ||..o{ BuchAutor

@enduml
